import javax.swing.*;
import javax.swing.table.DefaultTableModel;
import java.awt.event.*;

public class LibraryManagementSystem extends JFrame implements ActionListener {

    JLabel l1, l2, l3;
    JTextField tf1, tf2, tf3;

    JButton addBtn, viewBtn, deleteBtn, clearBtn;

    JTable table;
    DefaultTableModel model;

    public LibraryManagementSystem() {

        setTitle("Library Management System");
        setSize(700, 500);
        setLayout(null);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);

        l1 = new JLabel("Book ID");
        l1.setBounds(30, 30, 100, 30);
        add(l1);

        tf1 = new JTextField();
        tf1.setBounds(150, 30, 150, 30);
        add(tf1);

        l2 = new JLabel("Book Name");
        l2.setBounds(30, 80, 100, 30);
        add(l2);

        tf2 = new JTextField();
        tf2.setBounds(150, 80, 150, 30);
        add(tf2);

        l3 = new JLabel("Author Name");
        l3.setBounds(30, 130, 100, 30);
        add(l3);

        tf3 = new JTextField();
        tf3.setBounds(150, 130, 150, 30);
        add(tf3);

        addBtn = new JButton("Add Book");
        addBtn.setBounds(30, 200, 120, 30);
        add(addBtn);

        viewBtn = new JButton("View Books");
        viewBtn.setBounds(170, 200, 120, 30);
        add(viewBtn);

        deleteBtn = new JButton("Delete Book");
        deleteBtn.setBounds(310, 200, 120, 30);
        add(deleteBtn);

        clearBtn = new JButton("Clear");
        clearBtn.setBounds(450, 200, 120, 30);
        add(clearBtn);

        model = new DefaultTableModel();
        model.addColumn("Book ID");
        model.addColumn("Book Name");
        model.addColumn("Author Name");

        table = new JTable(model);

        JScrollPane sp = new JScrollPane(table);
        sp.setBounds(30, 260, 620, 150);
        add(sp);

        addBtn.addActionListener(this);
        viewBtn.addActionListener(this);
        deleteBtn.addActionListener(this);
        clearBtn.addActionListener(this);

        setVisible(true);
    }

    public void actionPerformed(ActionEvent e) {

        if (e.getSource() == addBtn) {

            String id = tf1.getText();
            String name = tf2.getText();
            String author = tf3.getText();

            model.addRow(new Object[]{id, name, author});

            JOptionPane.showMessageDialog(this,
                    "Book Added Successfully!");

        }

        if (e.getSource() == deleteBtn) {

            int row = table.getSelectedRow();

            if (row >= 0) {
                model.removeRow(row);

                JOptionPane.showMessageDialog(this,
                        "Book Deleted Successfully!");
            } else {

                JOptionPane.showMessageDialog(this,
                        "Please Select a Row!");
            }
        }

        if (e.getSource() == clearBtn) {

            tf1.setText("");
            tf2.setText("");
            tf3.setText("");
        }

        if (e.getSource() == viewBtn) {

            JOptionPane.showMessageDialog(this,
                    "Books Displayed in Table");
        }
    }

    public static void main(String[] args) {

        new LibraryManagementSystem();
    }
}
